    ano: "2025",
    tipologia: "Estructural",
    imagen: "/proyectos/planta-malla.png"
  },
  {
    id: 2,
    numero: "03",
    titulo: "Axonometría Malla",
    ano: "2025",
    tipologia: "Estructural",
    imagen: "/proyectos/axonometriamalla.png"
  },
  {
    id: 3,
    numero: "04",
    titulo: "Taller Sert",
    ano: "2025",
    tipologia: "Arquitectura",
    imagen: "/proyectos/taller-sert1.png"
  },
  {
    id: 4,
    numero: "05",
    titulo: "Collage I",
    ano: "2025",
    tipologia: "Dibujo",
    imagen: "/proyectos/collage1.png"
  },
  {
    id: 5,
    numero: "06",
    titulo: "Collage II",
    ano: "2025",
    tipologia: "Dibujo",
    imagen: "/proyectos/collage2.png"
  },
  {
    id: 6,
    numero: "07",
    titulo: "Plantas La Línea",
    ano: "2025",
    tipologia: "Dibujo",
    imagen: "/proyectos/plantas-lalinea.png"
  },
  {
    id: 7,
    numero: "08",
    titulo: "Collage Malla",
    ano: "2025",
    tipologia: "Estructural",
    imagen: "/proyectos/Collage_Malla.png"
  },
  {
    id: 8,
    numero: "09",
    titulo: "Ciudad Blanca",
    ano: "2026",
    tipologia: "Fotografía",
    imagen: "/proyectos/ciudadblanca.JPG"
  },
  {
    id: 9,
    numero: "10",
    titulo: "Sketch Malla",
    ano: "2025",
    tipologia: "Croquis",
    imagen: "/proyectos/sketch-malla.jpg"
  },
  {
    id: 10,
    numero: "11",
    titulo: "Diagrama Malla",
    ano: "2025",
    tipologia: "Estructural",
